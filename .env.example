# Which LLM provider to use: "openrouter" (default) or "gemini".
# Useful to switch to "gemini" if OpenRouter's free-tier daily cap
# (50 requests/day) is exhausted -- separate quota, same $0 cost.
LLM_PROVIDER=openrouter

# --- OpenRouter (default provider) ---
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: identify your app to OpenRouter (helps with free-tier rate limits)
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=rag-doc-search

# --- Gemini (alternative provider, set LLM_PROVIDER=gemini to use) ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default model (gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
